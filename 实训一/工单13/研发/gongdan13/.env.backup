# ========== 分块参数 ==========
CHUNK_SIZE=300
CHUNK_OVERLAP=100

# ========== 向量库选择 ==========
VECTOR_BACKEND=milvus

# ========== Milvus ==========
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks

# ========== 检索参数 ==========
SEARCH_MODE=hybrid
TOP_K=8
BM25_TOP_K=8
FAISS_TOP_K=8
RRF_K=60
SIMILARITY_THRESHOLD=0.3

# ========== 加权融合权重 ==========
BM25_WEIGHT=0.4
VEC_WEIGHT=0.6

# ========== Embedding 模型 ==========
EMBEDDING_MODEL_PATH=D:\桌面\模型\m3e-base

# ========== Reranker（本地） ==========
ENABLE_RERANKER=1
RERANKER_MODEL_PATH=D:\桌面\模型\bge-reranker-base
RERANK_TOP_K=3

# ========== LLM（小米 Mimo sk- key） ==========
# sk- 前缀必须用 api.xiaomimimo.com，不要用 token-plan URL
LLM_API_KEY=sk-cj21uc18zej6qajrgjkvffucrudb82xeazvrjx7waowdj6c6
LLM_API_BASE=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5
LLM_TIMEOUT=30

# ========== 视觉模型（图片解析，sk- key 支持图像） ==========
VISION_API_KEY=sk-cj21uc18zej6qajrgjkvffucrudb82xeazvrjx7waowdj6c6
VISION_API_BASE=https://api.xiaomimimo.com/v1
VISION_MODEL=mimo-v2.5

# ========== 多轮对话 ==========
ENABLE_MULTI_TURN=1
MAX_HISTORY_TURNS=10

# ========== 历史问题检索 ==========
ENABLE_QUESTION_CACHE=1
QA_SIMILARITY_THRESHOLD=0.999

# ========== HTTPS ==========
ENABLE_SSL=0

# ========== Redis short-term memory ==========
ENABLE_REDIS=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_MEMORY_TTL_SECONDS=604800

# ========== Neo4j graph retrieval ==========
ENABLE_NEO4J=1
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragneo4j123
NEO4J_TOP_K=5

# ========== MySQL persistence ==========
ENABLE_MYSQL=0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_db

# ========== JWT auth ==========
ENABLE_JWT=0
JWT_SECRET=change-this-secret
JWT_EXPIRE_HOURS=24
JWT_USERNAME=admin
JWT_PASSWORD=change-this-password

# ========== Content filter ==========
ENABLE_FILTER=0
FILTER_WORDS=
FILTER_RESPONSE=问题包含屏蔽词，已拦截。

# ========== 无相关信息回复 ==========
NO_INFO_RESPONSE=未找到相关信息，请尝试换个问法。
