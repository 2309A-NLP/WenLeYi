# ========== 分块参数 ==========
CHUNK_SIZE=300
CHUNK_OVERLAP=100

# ========== 向量库选择 ==========
# faiss（本地）或 milvus（远程服务）
VECTOR_BACKEND=milvus

# ========== Milvus ==========
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_chunks

# ========== 检索参数 ==========
SEARCH_MODE=hybrid
TOP_K=5
BM25_TOP_K=10
FAISS_TOP_K=10
RRF_K=60
SIMILARITY_THRESHOLD=0.3

# ========== 加权融合权重 ==========
BM25_WEIGHT=0.4
VEC_WEIGHT=0.6
GRAPH_WEIGHT=0.3

# ========== Embedding 模型 ==========
EMBEDDING_MODEL_PATH=

# ========== Reranker（本地） ==========
ENABLE_RERANKER=1
RERANKER_MODEL_PATH=
RERANK_TOP_K=3

# ========== LLM ==========
# sk- 前缀用 https://api.xiaomimimo.com/v1
# tp- 前缀用 https://token-plan-cn.xiaomimimo.com/v1（不支持图像）
LLM_API_KEY=
LLM_API_BASE=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5
LLM_TIMEOUT=30

# ========== 视觉模型（图片解析） ==========
VISION_API_KEY=
VISION_API_BASE=https://api.xiaomimimo.com/v1
VISION_MODEL=mimo-v2.5

# ========== 多轮对话 ==========
ENABLE_MULTI_TURN=1
MAX_HISTORY_TURNS=10

# ========== 历史问题检索 ==========
ENABLE_QUESTION_CACHE=1
QA_SIMILARITY_THRESHOLD=0.85

# ========== HTTPS ==========
ENABLE_SSL=0

# ========== Redis short-term memory ==========
ENABLE_REDIS=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_MEMORY_TTL_SECONDS=604800

# ========== Neo4j graph retrieval ==========
ENABLE_NEO4J=0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_TOP_K=5

# ========== MySQL persistence ==========
ENABLE_MYSQL=0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_db

# ========== JWT auth ==========
ENABLE_JWT=0
JWT_SECRET=change-this-secret
JWT_EXPIRE_HOURS=24
JWT_USERNAME=admin
JWT_PASSWORD=change-this-password

# ========== Content filter ==========
ENABLE_FILTER=0
FILTER_WORDS=
FILTER_RESPONSE=问题包含屏蔽词，已拦截。

# ========== 无相关信息回复 ==========
NO_INFO_RESPONSE=未找到相关信息，请尝试换个问法。
